{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caram Browser",
  "version": "1.0.0",
  "identifier": "com.carambrowser.desktop",
  "build": {
    "beforeDevCommand": "cd frontend && trunk serve --port 1420",
    "beforeBuildCommand": "cd frontend && trunk build --release",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "WebBrowser"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Caram Browser",
        "width": 1400,
        "height": 900,
        "minWidth": 950,
        "minHeight": 650,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
